# Copy to .env.local (git-ignored) to override. Everything prefixed VITE_ is
# embedded in the PUBLIC JavaScript bundle at build time: never put secrets here.

# Base path of the API. Default: resolved relative to the page, e.g. /api
# VITE_API_BASE=/api

# Dev/preview only: proxy the API to a real backend instead of using the mock.
# VITE_API_PROXY=http://localhost:8000
